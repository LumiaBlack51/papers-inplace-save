+    fn make_pdf() -> Vec<u8> {
+        let mut objects = vec![
+            "<< /Type /Catalog /Pages 2 0 R /AcroForm << /Fields [11 0 R] >> >>".to_string(),
+            "<< /Type /Pages /Count 8 /Kids [3 0 R 4 0 R 5 0 R 6 0 R 7 0 R 8 0 R 9 0 R 10 0 R] >>"
+                .to_string(),
+        ];
+        for page in 0..8 {
+            let annots = if page == 0 { "/Annots [11 0 R]" } else { "" };
+            objects.push(format!(
+                "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 600 800] /Resources << >> {annots} >>"
+            ));
+        }
+        objects.push(
+            "<< /Type /Annot /Subtype /Widget /FT /Tx /T (name) /Rect [10 10 90 30] /P 3 0 R >>"
+                .to_string(),
+        );
+        let mut pdf = "%PDF-1.4\n".to_string();
+        let mut offsets = Vec::new();
+        for (i, object) in objects.iter().enumerate() {
+            offsets.push(pdf.len());
+            pdf.push_str(&format!("{} 0 obj\n{}\nendobj\n", i + 1, object));
+        }
+        let xref = pdf.len();
+        pdf.push_str(&format!(
+            "xref\n0 {}\n0000000000 65535 f \n",
+            objects.len() + 1
+        ));
+        for offset in offsets {
+            pdf.push_str(&format!("{offset:010} 00000 n \n"));
+        }
+        pdf.push_str(&format!(
+            "trailer\n<< /Size {} /Root 1 0 R >>\nstartxref\n{xref}\n%%EOF\n",
+            objects.len() + 1
+        ));
+        pdf.into_bytes()
+    }
+
+    fn text_field(
+        document: &Document,
+    ) -> (papers_document::DocumentForms, papers_document::FormField) {
+        let forms = document
+            .clone()
+            .dynamic_cast::<papers_document::DocumentForms>()
+            .unwrap();
+        let field = forms
+            .form_fields(&document.page(0).unwrap())
+            .unwrap()
+            .nth(0)
+            .unwrap()
+            .data()
+            .and_downcast::<papers_document::FormField>()
+            .unwrap();
+        (forms, field)
+    }
+
+    fn assert_saved_text(file: &gio::File, expected: &str) {
+        let saved = Document::factory_get_document(&file.uri()).unwrap();
+        saved.load(&file.uri()).unwrap();
+        let (forms, field) = text_field(&saved);
+        assert_eq!(
+            forms.form_field_text_get_text(&field).as_deref(),
+            Some(expected)
+        );
+    }
+
+    // The worker has made its snapshot. Its finished callback still has to
+    // run on the main context, which we intentionally do not pump here.
+    fn save_until_serialized(
+        save: &gtk::Shortcut,
+        document_view: &PpsDocumentView,
+        document: &Document,
+    ) {
+        let (serialized, ready) = std::sync::mpsc::channel();
+        let handler = document.connect_modified_notify(move |doc| {
+            if !doc.is_modified() {
+                let _ = serialized.send(());
+            }
+        });
+        activate_shortcut(save, document_view);
+        ready.recv_timeout(Duration::from_secs(10)).unwrap();
+        document.disconnect(handler);
+    }
+
+    fn find_view(widget: &gtk::Widget) -> Option<papers_view::View> {
+        if let Ok(view) = widget.clone().downcast::<papers_view::View>() {
+            return Some(view);
+        }
+        let mut child = widget.first_child();
+        while let Some(widget) = child {
+            if let Some(view) = find_view(&widget) {
+                return Some(view);
+            }
+            child = widget.next_sibling();
+        }
+        None
+    }
+
+    fn trigger_contains(trigger: &gtk::ShortcutTrigger, expected: &gtk::ShortcutTrigger) -> bool {
+        if let Some(alternative) = trigger.downcast_ref::<gtk::AlternativeTrigger>() {
+            trigger_contains(&alternative.first(), expected)
+                || trigger_contains(&alternative.second(), expected)
+        } else {
+            trigger.to_str() == expected.to_str()
+        }
+    }
+
+    fn find_shortcuts(
+        widget: &gtk::Widget,
+        trigger: &gtk::ShortcutTrigger,
+        found: &mut Vec<(gtk::Widget, gtk::Shortcut)>,
+    ) {
+        let controllers = widget.observe_controllers();
+        for i in 0..controllers.n_items() {
+            let Some(controller) = controllers
+                .item(i)
+                .and_downcast::<gtk::ShortcutController>()
+            else {
+                continue;
+            };
+            for j in 0..controller.n_items() {
+                let shortcut = controller.item(j).and_downcast::<gtk::Shortcut>().unwrap();
+                if shortcut
+                    .trigger()
+                    .is_some_and(|t| trigger_contains(&t, trigger))
+                {
+                    found.push((widget.clone(), shortcut));
+                }
+            }
+        }
+        let mut child = widget.first_child();
+        while let Some(widget) = child {
+            find_shortcuts(&widget, trigger, found);
+            child = widget.next_sibling();
+        }
+    }
+
+    fn document_shortcut(
+        widget: &gtk::Widget,
+        accelerator: &str,
+        action_name: &str,
+    ) -> gtk::Shortcut {
+        let trigger = gtk::ShortcutTrigger::parse_string(accelerator).unwrap();
+        let mut found = Vec::new();
+        find_shortcuts(widget, &trigger, &mut found);
+        // GTK also creates signal shortcuts for the Save As menu button.
+        // Check the document's named shortcut, independent of those menu widgets.
+        found.retain(|(_, shortcut)| {
+            shortcut
+                .action()
+                .is_some_and(|a| a.is::<gtk::NamedAction>())
+        });
+        assert_eq!(found.len(), 1, "expected one binding for {accelerator}");
+        let (_, shortcut) = found.pop().unwrap();
+        let action = shortcut
+            .action()
+            .and_downcast::<gtk::NamedAction>()
+            .unwrap();
+        assert_eq!(
+            action.action_name(),
+            action_name,
+            "wrong action for {accelerator}"
+        );
+        shortcut
+    }
+
+    fn activate_shortcut(shortcut: &gtk::Shortcut, widget: &impl IsA<gtk::Widget>) {
+        assert!(shortcut.action().unwrap().activate(
+            gtk::ShortcutActionFlags::empty(),
+            widget,
+            shortcut.arguments().as_ref(),
+        ));
+    }
+
+    #[test]
+    fn in_place_save_keeps_document_page_and_scroll_and_external_reload_still_works() {
+        gtk::init().unwrap();
+        let context = glib::MainContext::default();
+        let _context = context.acquire().unwrap();
+        let app = PpsApplication::new();
+        app.register(gio::Cancellable::NONE).unwrap();
+        let window = PpsWindow::new();
+        let path =
+            std::env::temp_dir().join(format!("papers-save-view-{}.pdf", std::process::id()));
+        std::fs::write(&path, make_pdf()).unwrap();
+        let file = gio::File::for_path(&path);
+        window.open(&file, None, None);
+        window.present();
+        pump_until(|| window.document().is_some());
+        pump_for(Duration::from_millis(500));
+
+        let document_view = window.imp().document_view.clone();
+        // Resolve the shortcuts loaded from the compiled UI resource. Calling
+        // doc.save directly would miss a Ctrl+S accidentally bound to save-as.
+        let save = document_shortcut(document_view.upcast_ref(), "<Ctrl>S", "doc.save");
+        document_shortcut(document_view.upcast_ref(), "<Ctrl><Shift>S", "doc.save-as");
+        let model = document_view.model();
+        model.set_page(4);
+        pump_for(Duration::from_millis(500));
+        let view = find_view(document_view.upcast_ref::<gtk::Widget>()).unwrap();
+        let scroll = view.dynamic_cast::<gtk::Scrollable>().unwrap();
+        let vertical = scroll.vadjustment().unwrap();
+        vertical.set_value(vertical.value() + 120.0);
+        pump_for(Duration::from_secs(2));
+        let page = model.page();
+        let scroll = vertical.value();
+        let document = window.document().unwrap();
+        let reloads = Rc::new(Cell::new(0));
+        model.connect_document_notify(glib::clone!(
+            #[strong]
+            reloads,
+            move |_| reloads.set(reloads.get() + 1)
+        ));
+
+        for cycle in 0..3 {
+            // Also cancel a reload that was queued before this save began.
+            window
+                .imp()
+                .monitor
+                .borrow()
+                .as_ref()
+                .unwrap()
+                .emit_by_name::<()>("changed", &[]);
+            let annotation = papers_document::AnnotationText::new(&document.page(4).unwrap());
+            annotation.set_contents(&format!("save cycle {cycle}"));
+            document
+                .dynamic_cast_ref::<DocumentAnnotations>()
+                .unwrap()
+                .add_annotation(&annotation);
+            activate_shortcut(&save, &document_view);
+            // A repeated Ctrl+S must not cancel the running save or its guard.
+            activate_shortcut(&save, &document_view);
+            pump_until(|| {
+                !window
+                    .imp()
+                    .monitor
+                    .borrow()
+                    .as_ref()
+                    .unwrap()
+                    .is_suspended()
+            });
+            // Cover both immediate monitor events and the five-second fallback.
+            pump_for(Duration::from_secs(6));
+            assert_eq!(reloads.get(), 0, "own saves must not replace the document");
+            assert_eq!(window.document(), Some(document.clone()));
+            assert_eq!(model.page(), page);
+            assert!(
+                (vertical.value() - scroll).abs() < 0.01,
+                "save changed the scroll position from {scroll} to {} in cycle {cycle}",
+                vertical.value()
+            );
+            let saved = Document::factory_get_document(&file.uri()).unwrap();
+            saved.load(&file.uri()).unwrap();
+            assert_eq!(saved.n_pages(), 8);
+            let annotations = saved
+                .dynamic_cast_ref::<DocumentAnnotations>()
+                .unwrap()
+                .annotations(&saved.page(4).unwrap());
+            assert_eq!(annotations.len(), cycle + 1);
+        }
+
+        // The backend clears its flags when serialization succeeds. Force
+        // transfer failure after that stage, then retry the same live edits.
+        let (forms, field) = text_field(&document);
+        forms.form_field_text_set_text(&field, "RetryMe");
+        let backup = path.with_extension("backup.pdf");
+        std::fs::rename(&path, &backup).unwrap();
+        std::fs::create_dir(&path).unwrap();
+        save_until_serialized(&save, &document_view, &document);
+        window.close();
+        assert!(window.is_visible());
+        pump_until(|| window.visible_dialog().is_some());
+        assert!(path.is_dir());
+        assert!(window.is_visible());
+        assert!(!document.is_modified());
+        assert!(document_view.modified_description().is_some());
+        assert_eq!(reloads.get(), 0);
+        std::fs::remove_dir(&path).unwrap();
+        std::fs::rename(&backup, &path).unwrap();
+
+        let dialog = window
+            .visible_dialog()
+            .and_downcast::<adw::AlertDialog>()
+            .unwrap();
+        dialog
+            .default_widget()
+            .and_downcast::<gtk::Button>()
+            .unwrap()
+            .emit_clicked();
+        pump_until(|| {
+            !window
+                .imp()
+                .monitor
+                .borrow()
+                .as_ref()
+                .unwrap()
+                .is_suspended()
+        });
+        assert!(window.is_visible());
+        assert!(document_view.modified_description().is_none());
+        assert_saved_text(&file, "RetryMe");
+
+        // An external edit still reloads after the successful retry.
+        std::fs::write(&path, make_pdf()).unwrap();
+        pump_until(|| reloads.get() > 0);
+
+        let document = window.document().unwrap();
+        let (forms, field) = text_field(&document);
+        forms.form_field_text_set_text(&field, "First");
+        save_until_serialized(&save, &document_view, &document);
+        forms.form_field_text_set_text(&field, "Second");
+        activate_shortcut(&save, &document_view);
+        window.close();
+        window.close();
+        assert!(
+            window.is_visible(),
+            "the window closed before the queue finished"
+        );
+        pump_until(|| !window.is_visible());
+        assert_saved_text(&file, "Second");
+        papers_view::Job::scheduler_wait();
+        std::fs::remove_file(path).unwrap();
+    }
+}
