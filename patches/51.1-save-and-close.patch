diff --git a/libview/tests/downstream/test-annotation-lifecycle.c b/libview/tests/downstream/test-annotation-lifecycle.c
new file mode 100644
index 0000000..e12efd9
--- /dev/null
+++ b/libview/tests/downstream/test-annotation-lifecycle.c
@@ -0,0 +1,127 @@
+#include <papers-view.h>
+#include <papers-document.h>
+#include "pps-annotation-overlay.h"
+
+static const char *fixture;
+static gboolean loaded;
+static void on_loaded (PpsAnnotationsContext *ctx, gpointer data) { loaded = TRUE; }
+static void wait_loaded (void) {
+    gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+    while (!loaded && g_get_monotonic_time () < deadline) {
+        while (g_main_context_iteration (NULL, FALSE));
+        g_usleep (1000);
+    }
+    g_assert_true (loaded);
+}
+static PpsDocument *load_doc (void) {
+    g_autofree char *uri = g_filename_to_uri (fixture, NULL, NULL);
+    GError *error = NULL;
+    PpsDocument *doc = pps_document_factory_get_document (uri, &error);
+    g_assert_no_error (error);
+    g_assert_nonnull (doc);
+    g_assert_true (pps_document_load (doc, uri, &error));
+    g_assert_no_error (error);
+    return g_object_ref_sink (doc);
+}
+static GtkWidget *find_text_view (GtkWidget *widget) {
+    if (GTK_IS_TEXT_VIEW (widget)) return widget;
+    for (GtkWidget *child = gtk_widget_get_first_child (widget); child; child = gtk_widget_get_next_sibling (child)) {
+        GtkWidget *result = find_text_view (child);
+        if (result) return result;
+    }
+    return NULL;
+}
+static void lifecycle (gconstpointer mode) {
+    PpsAnnotationModel *annotation_model = pps_annotation_model_new ();
+    PpsDocumentModel *model = g_object_new (PPS_TYPE_DOCUMENT_MODEL, "annotation-model", annotation_model, NULL);
+    PpsUndoContext *undo = pps_undo_context_new (model);
+    PpsAnnotationsContext *ctx = pps_annotations_context_new (model, undo);
+    PpsDocument *doc = load_doc ();
+    g_signal_connect (ctx, "annots-loaded", G_CALLBACK (on_loaded), NULL);
+    loaded = FALSE;
+    pps_document_model_set_document (model, doc);
+    wait_loaded ();
+    GListModel *annots = pps_annotations_context_get_annots_model (ctx);
+    guint initial = g_list_model_get_n_items (annots);
+    PpsPoint point = { 30, 30 };
+    GdkRGBA color = { 0, 0, 0, 1 };
+    PpsAnnotation *annot = g_object_ref (pps_annotations_context_add_annotation_sync (
+        ctx, 0, PPS_ANNOTATION_TYPE_FREE_TEXT, &point, &point, &color, NULL));
+    g_assert_cmpuint (g_list_model_get_n_items (annots), ==, initial + 1);
+    if (g_str_has_prefix (mode, "idle-")) {
+        GtkWidget *overlay = g_object_ref_sink (pps_overlay_annotation_entry_new (annot, ctx, model));
+        GtkWidget *text = find_text_view (overlay);
+        g_assert_nonnull (text);
+        GListModel *controllers = gtk_widget_observe_controllers (text);
+        gboolean emitted = FALSE;
+        for (guint i = 0; i < g_list_model_get_n_items (controllers); i++) {
+            GObject *controller = g_list_model_get_item (controllers, i);
+            if (GTK_IS_EVENT_CONTROLLER_FOCUS (controller)) {
+                g_signal_emit_by_name (controller, "leave");
+                g_signal_emit_by_name (controller, "leave");
+                emitted = TRUE;
+            }
+            g_object_unref (controller);
+        }
+        g_object_unref (controllers);
+        g_assert_true (emitted);
+        if (g_str_equal (mode, "idle-dispose")) {
+            g_object_unref (overlay);
+            overlay = NULL;
+        } else if (g_str_equal (mode, "idle-refilled")) {
+            gtk_text_buffer_set_text (gtk_text_view_get_buffer (GTK_TEXT_VIEW (text)), "keep this annotation", -1);
+        } else if (g_str_equal (mode, "idle-removed")) {
+            pps_annotations_context_remove_annotation (ctx, annot);
+        } else if (g_str_equal (mode, "idle-reload")) {
+            PpsDocument *replacement = load_doc ();
+            loaded = FALSE;
+            pps_document_model_set_document (model, replacement);
+            wait_loaded ();
+        }
+        while (g_main_context_iteration (NULL, FALSE));
+        guint expected = (g_str_equal (mode, "idle-dispose") || g_str_equal (mode, "idle-refilled")) ? initial + 1 : initial;
+        g_assert_cmpuint (g_list_model_get_n_items (annots), ==, expected);
+        if (overlay) g_object_unref (overlay);
+    } else if (g_str_equal (mode, "stale")) {
+        PpsDocument *replacement = load_doc ();
+        loaded = FALSE;
+        pps_document_model_set_document (model, replacement);
+        wait_loaded ();
+        guint count = g_list_model_get_n_items (annots);
+        gboolean modified = pps_document_get_modified (replacement);
+        pps_annotations_context_remove_annotation (ctx, annot);
+        g_assert_cmpuint (g_list_model_get_n_items (annots), ==, count);
+        g_assert_cmpint (pps_document_get_modified (replacement), ==, modified);
+        g_assert_null (pps_undo_context_get_last_action (undo));
+    } else {
+        pps_annotations_context_remove_annotation (ctx, annot);
+        g_assert_cmpuint (g_list_model_get_n_items (annots), ==, initial);
+        gpointer last = pps_undo_context_get_last_action (undo);
+        if (g_str_equal (mode, "duplicate")) {
+            pps_annotations_context_remove_annotation (ctx, annot);
+            g_assert_true (last == pps_undo_context_get_last_action (undo));
+        }
+        pps_undo_context_undo (undo);
+        g_assert_cmpuint (g_list_model_get_n_items (annots), ==, initial + 1);
+        pps_undo_context_redo (undo);
+        g_assert_cmpuint (g_list_model_get_n_items (annots), ==, initial);
+    }
+    g_object_unref (annot);
+    /* Model/context signal lifetime is outside these short-lived regression cases. */
+}
+int main (int argc, char **argv) {
+    fixture = g_getenv ("PAPERS_TEST_PDF");
+    g_assert_nonnull (fixture);
+    g_test_init (&argc, &argv, NULL);
+    gtk_init ();
+    g_assert_true (pps_init ());
+    g_test_add_data_func ("/annotations/normal-remove-undo-redo", "normal", lifecycle);
+    g_test_add_data_func ("/annotations/stale-after-reload", "stale", lifecycle);
+    g_test_add_data_func ("/annotations/duplicate-remove", "duplicate", lifecycle);
+    g_test_add_data_func ("/annotations/idle-empty", "idle-empty", lifecycle);
+    g_test_add_data_func ("/annotations/idle-dispose", "idle-dispose", lifecycle);
+    g_test_add_data_func ("/annotations/idle-refilled", "idle-refilled", lifecycle);
+    g_test_add_data_func ("/annotations/idle-removed", "idle-removed", lifecycle);
+    g_test_add_data_func ("/annotations/idle-reload", "idle-reload", lifecycle);
+    return g_test_run ();
+}
diff --git a/libview/tests/downstream/test-annotation-popup.c b/libview/tests/downstream/test-annotation-popup.c
new file mode 100644
index 0000000..9625a76
--- /dev/null
+++ b/libview/tests/downstream/test-annotation-popup.c
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <adwaita.h>
+#include <glib/gstdio.h>
+#include <papers-document.h>
+#include <papers-view.h>
+
+static gboolean loaded;
+
+static void
+annots_loaded (PpsAnnotationsContext *context, gpointer data)
+{
+	(void) context;
+	(void) data;
+	loaded = TRUE;
+}
+
+static void
+wait_loaded (void)
+{
+	gint64 deadline = g_get_monotonic_time () + 10 * G_TIME_SPAN_SECOND;
+	while (!loaded && g_get_monotonic_time () < deadline) {
+		while (g_main_context_iteration (NULL, FALSE))
+			;
+		g_usleep (1000);
+	}
+	g_assert_true (loaded);
+}
+
+static PpsDocument *
+open_document (const char *uri)
+{
+	g_autoptr (GError) error = NULL;
+	PpsDocument *document = pps_document_factory_get_document (uri, &error);
+	g_assert_no_error (error);
+	g_assert_nonnull (document);
+	g_assert_true (pps_document_load (document, uri, &error));
+	g_assert_no_error (error);
+	return g_object_ref_sink (document);
+}
+
+static GtkWidget *
+open_popup (PpsAnnotation *annot, GtkWidget **parent)
+{
+	*parent = gtk_window_new ();
+	PpsView *view = pps_view_new ();
+	gtk_window_set_child (GTK_WINDOW (*parent), GTK_WIDGET (view));
+	pps_view_open_annotation_editor (view, annot);
+	/* Drain the deferred present before testing an explicit close. */
+	while (g_main_context_iteration (NULL, FALSE))
+		;
+	GtkWidget *popup = g_object_get_data (G_OBJECT (annot), "popup");
+	g_assert_nonnull (popup);
+	g_assert_true (gtk_widget_get_visible (popup));
+	return popup;
+}
+
+int
+main (int argc, char **argv)
+{
+	g_assert_true (argc == 2 || argc == 3);
+	const char *contents = argc == 3 ? argv[2] : "popup state regression";
+	g_assert_true (pps_init ());
+	adw_init ();
+	g_autoptr (GError) error = NULL;
+	g_autofree char *dir = g_dir_make_tmp ("papers-popup-XXXXXX", &error);
+	g_assert_no_error (error);
+	g_autofree char *path = g_build_filename (dir, "copy.pdf", NULL);
+	g_autoptr (GFile) source = g_file_new_for_path (argv[1]);
+	g_autoptr (GFile) copy = g_file_new_for_path (path);
+	g_assert_true (g_file_copy (source, copy, G_FILE_COPY_NONE, NULL, NULL, NULL, &error));
+	g_assert_no_error (error);
+	g_autofree char *uri = g_file_get_uri (copy);
+	g_autoptr (PpsDocument) document = open_document (uri);
+	PpsAnnotationModel *annotation_model = pps_annotation_model_new ();
+	PpsDocumentModel *model = g_object_new (PPS_TYPE_DOCUMENT_MODEL,
+	                                      "annotation-model", annotation_model, NULL);
+	PpsUndoContext *undo = pps_undo_context_new (model);
+	PpsAnnotationsContext *context = pps_annotations_context_new (model, undo);
+	g_signal_connect (context, "annots-loaded", G_CALLBACK (annots_loaded), NULL);
+	pps_document_model_set_document (model, document);
+	wait_loaded ();
+	GListModel *annots = pps_annotations_context_get_annots_model (context);
+	guint initial_count = g_list_model_get_n_items (annots);
+	g_autoptr (PpsAnnotation) annot = NULL;
+	if (argc == 3) {
+		for (guint i = 0; i < initial_count; i++) {
+			g_autoptr (PpsAnnotation) candidate = g_list_model_get_item (annots, i);
+			if (g_strcmp0 (pps_annotation_get_contents (candidate), contents) == 0) {
+				annot = g_object_ref (candidate);
+				break;
+			}
+		}
+	} else {
+		PpsPoint point = { 40, 40 };
+		GdkRGBA color = { 1, 1, 0, 1 };
+		annot = g_object_ref (pps_annotations_context_add_annotation_sync (
+		    context, 0, PPS_ANNOTATION_TYPE_TEXT, &point, &point, &color, NULL));
+		pps_annotation_set_contents (annot, contents);
+		PpsRectangle rectangle = { 50, 50, 250, 200 };
+		g_object_set (annot, "has-popup", TRUE, "rectangle", &rectangle, NULL);
+	}
+	g_assert_nonnull (annot);
+	PpsAnnotationMarkup *markup = PPS_ANNOTATION_MARKUP (annot);
+	pps_annotation_markup_set_popup_is_open (markup, TRUE);
+
+	GtkWidget *parent;
+	GtkWidget *popup = open_popup (annot, &parent);
+
+	/* Scrolling the page away only hides the window temporarily. */
+	pps_document_set_modified (document, FALSE);
+	gtk_widget_set_visible (popup, FALSE);
+	g_assert_true (pps_annotation_markup_get_popup_is_open (markup));
+	g_assert_false (pps_document_get_modified (document));
+	gtk_widget_set_visible (popup, TRUE);
+
+	/* The explicit close request must update the PDF state as well. */
+	gtk_window_close (GTK_WINDOW (popup));
+	g_assert_false (gtk_widget_get_visible (popup));
+	g_assert_false (pps_annotation_markup_get_popup_is_open (markup));
+	g_assert_true (pps_document_get_modified (document));
+	g_assert_cmpstr (pps_annotation_get_contents (annot), ==, contents);
+
+	g_autoptr (PpsJob) save = pps_job_save_new (document, uri, uri);
+	pps_job_run (save);
+	g_assert_true (pps_job_is_succeeded (save, &error));
+	g_assert_no_error (error);
+	gtk_window_destroy (GTK_WINDOW (popup));
+	gtk_window_destroy (GTK_WINDOW (parent));
+
+	/* Reopening must preserve the note and its closed popup. */
+	g_autoptr (PpsDocument) reopened = open_document (uri);
+	loaded = FALSE;
+	pps_document_model_set_document (model, reopened);
+	wait_loaded ();
+	g_assert_cmpuint (g_list_model_get_n_items (annots), ==, initial_count + (argc == 2));
+	gboolean found = FALSE;
+	for (guint i = 0; i < g_list_model_get_n_items (annots); i++) {
+		g_autoptr (PpsAnnotation) saved = g_list_model_get_item (annots, i);
+		if (g_strcmp0 (pps_annotation_get_contents (saved), contents) != 0)
+			continue;
+		found = TRUE;
+		g_assert_false (pps_annotation_markup_get_popup_is_open (PPS_ANNOTATION_MARKUP (saved)));
+		/* The saved note can still be explicitly opened and closed again. */
+		popup = open_popup (saved, &parent);
+		g_assert_true (pps_annotation_markup_get_popup_is_open (PPS_ANNOTATION_MARKUP (saved)));
+		gtk_window_close (GTK_WINDOW (popup));
+		g_assert_false (gtk_widget_get_visible (popup));
+		g_assert_false (pps_annotation_markup_get_popup_is_open (PPS_ANNOTATION_MARKUP (saved)));
+		gtk_window_destroy (GTK_WINDOW (popup));
+		gtk_window_destroy (GTK_WINDOW (parent));
+	}
+	g_assert_true (found);
+	g_assert_cmpint (g_remove (path), ==, 0);
+	g_assert_cmpint (g_rmdir (dir), ==, 0);
+	g_print ("PASS: temporary hide preserves open state; explicit close survives save/reopen with note contents intact\n");
+	return 0;
+}
diff --git a/libview/tests/downstream/test-render-text.c b/libview/tests/downstream/test-render-text.c
new file mode 100644
index 0000000..cc299ab
--- /dev/null
+++ b/libview/tests/downstream/test-render-text.c
@@ -0,0 +1,77 @@
+#include <papers-view.h>
+#include <papers-document.h>
+#include "pps-annotation-overlay.h"
+#include <cairo-pdf.h>
+#include <glib/gstdio.h>
+static GtkWidget *find_text (GtkWidget *w) {
+ if(GTK_IS_TEXT_VIEW(w)) return w;
+ for(GtkWidget *c=gtk_widget_get_first_child(w);c;c=gtk_widget_get_next_sibling(c)) {
+  GtkWidget *r=find_text(c); if(r) return r;
+ }
+ return NULL;
+}
+static unsigned dark_pixels (PpsDocument *doc) {
+ PpsPage *page = pps_document_get_page (doc,0);
+ PpsRenderContext *rc = pps_render_context_new (page,0,1.,PPS_RENDER_ANNOTS_ALL);
+ cairo_surface_t *s = pps_document_render (doc,rc);
+ cairo_surface_flush(s);
+ unsigned count=0;
+ unsigned char *bytes=cairo_image_surface_get_data(s);
+ int stride=cairo_image_surface_get_stride(s);
+ for(int y=0;y<200;y++) for(int x=0;x<300;x++) {
+  unsigned char *p=bytes+y*stride+4*x;
+  if(p[0]<240 || p[1]<240 || p[2]<240) count++;
+ }
+ cairo_surface_destroy(s); g_object_unref(rc); g_object_unref(page);
+ return count;
+}
+int main(void) {
+ pps_init();gtk_init();
+ GError *error=NULL;
+ char *dir=g_dir_make_tmp("papers-render-test-XXXXXX",&error);
